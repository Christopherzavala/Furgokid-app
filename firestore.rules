rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
              return isAuthenticated() &&
                exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
            }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isDriver() {
      return hasRole('driver');
    }
    
    function isParent() {
      return hasRole('parent');
    }

    // Driver approved by admin (role == 'driver' AND approved == true)
    function isApprovedDriver() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let userData = userDoc.data;
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userData.role == 'driver' &&
             userData.keys().hasAny(['approved']) &&
             userData.approved == true;
    }

    function validTrackingLocation(driverId) {
      return request.resource.data.keys().hasOnly([
               'driverId',
               'latitude',
               'longitude',
               'speed',
               'active',
               'updatedAt',
               'matchId'
             ]) &&
             request.resource.data.driverId == driverId &&
             request.resource.data.latitude is number &&
             request.resource.data.latitude >= -90 &&
             request.resource.data.latitude <= 90 &&
             request.resource.data.longitude is number &&
             request.resource.data.longitude >= -180 &&
             request.resource.data.longitude <= 180 &&
             request.resource.data.speed is number &&
             request.resource.data.speed >= 0 &&
             request.resource.data.active is bool &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.updatedAt <= request.time &&
             request.resource.data.updatedAt >
               request.time - duration.value(2, 'm');
    }

    function activeMatch(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
             get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'active';
    }
    
    // Prevent role escalation
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    // Prevent self-approval
    function approvedUnchanged() {
      return request.resource.data.approved == resource.data.approved;
    }
    
    // ============================================================================
    // RATE LIMITING FUNCTIONS (Big Tech Standard)
    // ============================================================================
    
    // Check if enough time has passed since last write (prevents spam)
    function rateLimit(cooldownSeconds) {
      return !('lastModified' in resource.data) || 
             request.time > resource.data.lastModified + duration.value(cooldownSeconds, 's');
    }
    
    // Check if user hasn't exceeded daily limit
    function dailyLimit(limitCount) {
      let today = request.time.toMillis() / 86400000; // Days since epoch
      let lastUpdate = resource.data.get(['rateLimitDay'], 0);
      let count = resource.data.get(['rateLimitCount'], 0);
      
      // Reset counter if it's a new day
      return (today > lastUpdate) || (count < limitCount);
    }
    
    // Validate request size (prevent large document spam)
    function validRequestSize() {
      return request.resource.size() < 1000000; // 1MB max document size
    }

    function validNewVacancyCapacity() {
      return request.resource.data.totalSeats is int &&
             request.resource.data.totalSeats > 0 &&
             request.resource.data.availableSeats is int &&
             request.resource.data.availableSeats == request.resource.data.totalSeats &&
             request.resource.data.reservedSeats is int &&
             request.resource.data.reservedSeats == 0;
    }
    
    // Ensure required fields for rate limiting are set
    function setRateLimitFields() {
      let today = request.time.toMillis() / 86400000;
      let isNewDay = !('rateLimitDay' in resource.data) || 
                      (request.time.toMillis() / 86400000) > resource.data.rateLimitDay;
      
      return request.resource.data.lastModified == request.time &&
             request.resource.data.rateLimitDay == today &&
             request.resource.data.rateLimitCount == (isNewDay ? 1 : resource.data.rateLimitCount + 1);
    }
    
    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    
    match /users/{userId} {
      // Anyone authenticated can read their own profile or admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile during registration
      // Role must be 'parent' or 'driver' (NOT 'admin') - prevents privilege escalation
      allow create: if isAuthenticated() && 
                      isOwner(userId) &&
                      request.resource.data.role in ['parent', 'driver'] &&
                      validRequestSize();
      
      // Users can update their own profile but cannot change their role
      // Rate limit: max 1 update per minute (prevent spam)
      allow update: if isOwner(userId) &&
                      roleUnchanged() &&
                      approvedUnchanged() &&
                      rateLimit(60) &&
                      validRequestSize();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ============================================================================
    // ROUTES COLLECTION
    // ============================================================================
    
    match /routes/{routeId} {
      // Only route owner (approved driver) or admin can read routes
      allow read: if isAdmin() ||
                    (isApprovedDriver() && resource.data.driverId == request.auth.uid);
      
      // Only APPROVED drivers can create routes
      // Rate limit: max 10 routes per day
      allow create: if isApprovedDriver() &&
                      request.resource.data.driverId == request.auth.uid &&
                      validRequestSize();
      
      // Only the route owner (driver) can update their routes
      // Rate limit: max 1 update per 5 minutes
      allow update: if isApprovedDriver() &&
                        resource.data.driverId == request.auth.uid &&
                        rateLimit(300) &&
                        validRequestSize();
      
      // Only route owner or admin can delete
      allow delete: if isAdmin() ||
                        (isApprovedDriver() && resource.data.driverId == request.auth.uid);
    }
    
    // ============================================================================
    // TRACKING POINTS COLLECTION
    // ============================================================================
    
    match /trackingPoints/{pointId} {
      // Historical GPS data is private to its owner and administrators.
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // The app has no supported writer for this legacy history collection.
      allow create, update: if false;
      
      allow delete: if isAdmin() ||
                              (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // ============================================================================
    // DRIVER TRACKING
    // ============================================================================

    match /tracking/{driverId} {
      allow read: if isAdmin() ||
                    (isDriver() && request.auth.uid == driverId);

      allow create, update: if false;

      allow delete: if isAdmin() ||
                      (isDriver() && request.auth.uid == driverId);
    }

    // ============================================================================
    // REQUESTS COLLECTION
    // ============================================================================
    
    match /requests/{requestId} {
      // Users can read requests where they are parent or driver
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
      
      // Request identity, matching, and status are written by authenticated backend operations.
      allow create, update: if false;
      
      // Request removal requires a backend operation that can validate related matches.
      allow delete: if false;
    }
    
    // ============================================================================
    // VACANCIES COLLECTION
    // ============================================================================
    
    match /vacancies/{vacancyId} {
      // Only vacancy owner (approved driver) or admin can read vacancies
      allow read: if isAdmin() ||
                    (isApprovedDriver() && resource.data.driverId == request.auth.uid);
      
      // Only APPROVED drivers can create vacancies
      // Rate limit: max 5 vacancies per day
      allow create: if isApprovedDriver() &&
                      request.resource.data.driverId == request.auth.uid &&
                      validNewVacancyCapacity() &&
                      validRequestSize();
      
      // Only the driver who created can update
      // Capacity is reserved and edited by trusted backend operations.
      allow update: if isApprovedDriver() &&
                      resource.data.driverId == request.auth.uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'driverId',
                        'totalSeats',
                        'availableSeats',
                        'reservedSeats'
                      ]) &&
                      rateLimit(600) &&
                      validRequestSize();
      
      // Only owner or admin can delete
      allow delete: if resource.data.reservedSeats is int &&
                      resource.data.reservedSeats == 0 &&
                      (isAdmin() ||
                       (isApprovedDriver() && resource.data.driverId == request.auth.uid));
    }
    
    // ============================================================================
    // MATCHES COLLECTION
    // ============================================================================
    
    match /matches/{matchId} {
      // Users can read matches where they are involved
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      
      // System/admin creates matches
      allow create, update, delete: if false;
      
      match /tracking/{locationId} {
        function canReadMatchLocation() {
          let matchData = get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data;
          return isAuthenticated() &&
                 matchData.status == 'active' &&
                 (matchData.parentId == request.auth.uid ||
                  matchData.driverId == request.auth.uid ||
                  isAdmin());
        }

        allow read: if locationId == 'current' &&
                      canReadMatchLocation() &&
                      (!exists(
                        /databases/$(database)/documents/matches/$(matchId)/tracking/current
                      ) ||
                       resource.data.updatedAt >
                         request.time - duration.value(2, 'm'));

        allow create, update: if locationId == 'current' &&
                                isDriver() &&
                                activeMatch(matchId) &&
                                get(
                                  /databases/$(database)/documents/matches/$(matchId)
                                ).data.driverId == request.auth.uid &&
                                request.resource.data.matchId == matchId &&
                                validTrackingLocation(request.auth.uid);

        // Shared current points are deleted only by trusted backend code.
        allow delete: if false;
      }
    }
    
    // ============================================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================================
    
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Only backend/cloud functions can write notifications
      allow write: if false;
    }
    
    // ============================================================================
    // CHAT/MESSAGES COLLECTION (if implemented)
    // ============================================================================
    
    match /chats/{chatId} {
      // Users can read chats they are part of
      allow read: if isAuthenticated() && 
                    request.auth.uid in resource.data.participants;
      
      // Users can create chats
      allow create: if isAuthenticated() && 
                      request.auth.uid in request.resource.data.participants;
      
      // Only participants can update (send messages)
      allow update: if isAuthenticated() && 
                      request.auth.uid in resource.data.participants;
      
      // Only admin can delete chats
      allow delete: if isAdmin();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && 
                        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
