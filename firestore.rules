rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAdminOrOps() {
      return hasRole('admin') || hasRole('ops');
    }

    function isParent() {
      return hasRole('parent');
    }

    // A user with an unresolved account-deletion request cannot create new
    // data. Reads and writes performed by other users are unaffected.
    function hasActiveDeletionRequest(userId) {
      return isAuthenticated() &&
             request.auth.uid == userId &&
             exists(/databases/$(database)/documents/accountDeletionRequests/$(userId)) &&
             get(/databases/$(database)/documents/accountDeletionRequests/$(userId)).data.status in
               ['pending', 'processing', 'failed'];
    }

    function hasOwnActiveDeletionRequest() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid)).data.status in
               ['pending', 'processing', 'failed'];
    }

    // Driver approved by admin (role == 'driver' AND approved == true AND driverRequestStatus == 'approved').
    // The existence check must precede access to the profile fields so a
    // missing profile fails closed.
    function isApprovedDriverFor(uid) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.role == 'driver' &&
             get(/databases/$(database)/documents/users/$(uid)).data.approved == true &&
             (!('driverRequestStatus' in get(/databases/$(database)/documents/users/$(uid)).data) ||
              get(/databases/$(database)/documents/users/$(uid)).data.driverRequestStatus == 'approved');
    }

    function isApprovedDriver() {
      return isApprovedDriverFor(request.auth.uid);
    }

    function validTrackingLocation() {
      return request.resource.data.keys().hasAll([
               'latitude',
               'longitude',
               'speed',
               'active',
               'updatedAt'
             ]) &&
             request.resource.data.keys().hasOnly([
               'latitude',
               'longitude',
               'speed',
               'active',
               'updatedAt'
             ]) &&
             request.resource.data.latitude is number &&
             request.resource.data.latitude >= -90 &&
             request.resource.data.latitude <= 90 &&
             request.resource.data.longitude is number &&
             request.resource.data.longitude >= -180 &&
             request.resource.data.longitude <= 180 &&
             request.resource.data.speed is number &&
             request.resource.data.speed >= 0 &&
             request.resource.data.active == true &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.updatedAt <= request.time &&
             request.resource.data.updatedAt >
               request.time - duration.value(2, 'm');
    }

    function activeMatch(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId)) &&
             get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'active';
    }

    // Match access is limited to the authenticated parent/driver assigned to
    // that match. Drivers must be approved; admins retain break-glass access.
    function canReadMatch(matchData) {
      return isAuthenticated() &&
             (isAdminOrOps() ||
              (isParent() && matchData.parentId == request.auth.uid) ||
              (isApprovedDriver() && matchData.driverId == request.auth.uid));
    }

    function isMatchParticipant(matchId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/matches/$(matchId)) &&
             (isAdminOrOps() ||
              get(/databases/$(database)/documents/matches/$(matchId)).data.driverId == request.auth.uid ||
              get(/databases/$(database)/documents/matches/$(matchId)).data.parentId == request.auth.uid);
    }

    // Prevent clients from adding, removing, or changing privileged fields.
    // Missing values are treated as different so an attacker cannot delete
    // `approved` or `role` and bypass a later comparison.
    function roleUnchanged() {
      return request.resource.data.keys().hasAll(['role']) &&
             resource.data.keys().hasAll(['role']) &&
             request.resource.data.role == resource.data.role;
    }

    // Prevent clients from adding, removing, or changing approval state.
    function approvedUnchanged() {
      return request.resource.data.keys().hasAll(['approved']) ==
             resource.data.keys().hasAll(['approved']) &&
             (!request.resource.data.keys().hasAll(['approved']) ||
              request.resource.data.approved == resource.data.approved);
    }

    // Driver-request state is managed exclusively by trusted backend code.
    // Owners cannot add, remove, or change these fields directly.
    function driverRequestStateUnchanged() {
      return request.resource.data.keys().hasAll(['driverRequestStatus']) ==
             resource.data.keys().hasAll(['driverRequestStatus']) &&
             (!request.resource.data.keys().hasAll(['driverRequestStatus']) ||
              request.resource.data.driverRequestStatus == resource.data.driverRequestStatus) &&
             request.resource.data.keys().hasAll(['driverRequestUpdatedAt']) ==
             resource.data.keys().hasAll(['driverRequestUpdatedAt']) &&
             (!request.resource.data.keys().hasAll(['driverRequestUpdatedAt']) ||
              request.resource.data.driverRequestUpdatedAt == resource.data.driverRequestUpdatedAt);
    }

    // Temporary privacy containment: the client may remove existing child
    // data for data minimization, but may not add or modify it. Trusted
    // backend writes (Admin SDK / callable functions) bypass Security Rules.
    function childFieldsUnchangedOrRemoved() {
      let addedKeys = request.resource.data.diff(resource.data).addedKeys();
      let changedKeys = request.resource.data.diff(resource.data).changedKeys();
      let childKeys = ['childrenCount', 'childrenNames', 'childrenAges', 'school'];
      return !addedKeys.hasAny(childKeys) && !changedKeys.hasAny(childKeys);
    }

    // ============================================================================
    // RATE LIMITING FUNCTIONS (Big Tech Standard)
    // ============================================================================

    // Check if enough time has passed since last write (prevents spam)
    function rateLimit(cooldownSeconds) {
      return !('lastModified' in resource.data) ||
             (request.resource.data.lastModified == request.time &&
              request.time > resource.data.lastModified + duration.value(cooldownSeconds, 's'));
    }

    // Validate request size (prevent large document spam)
    function validRequestSize() {
      return request.resource.size() < 1000000; // 1MB max document size
    }

    function validNewVacancyCapacity() {
      return request.resource.data.totalSeats is int &&
             request.resource.data.totalSeats > 0 &&
             request.resource.data.availableSeats is int &&
             request.resource.data.availableSeats == request.resource.data.totalSeats &&
             request.resource.data.reservedSeats is int &&
             request.resource.data.reservedSeats == 0;
    }

    // ============================================================================
    // ACCOUNT DELETION REQUESTS
    // ============================================================================

    match /accountDeletionRequests/{userId} {
      // The owner may inspect the request. All writes are performed by the
      // Admin SDK (and therefore bypass Firestore Security Rules).
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================

    match /users/{userId} {
      // A user can read their own profile. Admins and ops can read any profile.
      allow read: if isOwner(userId) || isAdminOrOps();

      // Profiles are created only by the blocking beforeUserCreated Auth
      // trigger. The Admin SDK bypasses Firestore Security Rules.
      allow create: if false;

      // Users can update their own profile but cannot add, remove, or change
      // role/approval state, or add/modify child-data fields.
      allow update: if isOwner(userId) &&
                      !hasActiveDeletionRequest(userId) &&
                      roleUnchanged() &&
                      approvedUnchanged() &&
                      driverRequestStateUnchanged() &&
                      childFieldsUnchangedOrRemoved() &&
                      rateLimit(60) &&
                      validRequestSize();

      // Only admins can delete users.
      allow delete: if isAdmin() && !hasOwnActiveDeletionRequest();
    }

    // ============================================================================
    // ROUTES COLLECTION
    // ============================================================================

    match /routes/{routeId} {
      // Only route owner (approved driver) or admin/ops can read routes
      allow read: if isAdminOrOps() ||
                    (isApprovedDriver() && resource.data.driverId == request.auth.uid);

      // Only APPROVED drivers can create routes
      // Rate limit: max 10 routes per day
      allow create: if isApprovedDriver() &&
                      request.resource.data.driverId == request.auth.uid &&
                      !hasActiveDeletionRequest(request.auth.uid) &&
                      validRequestSize();

      // Only the route owner (driver) can update their routes
      // Rate limit: max 1 update per 5 minutes
      allow update: if isApprovedDriver() &&
                        resource.data.driverId == request.auth.uid &&
                        request.resource.data.driverId == resource.data.driverId &&
                        !hasActiveDeletionRequest(request.auth.uid) &&
                        rateLimit(300) &&
                        validRequestSize();

      // Only route owner or admin can delete
      allow delete: if !hasOwnActiveDeletionRequest() &&
                        (isAdmin() ||
                         (isApprovedDriver() &&
                          resource.data.driverId == request.auth.uid &&
                          !hasActiveDeletionRequest(request.auth.uid)));
    }

    // ============================================================================
    // TRACKING POINTS COLLECTION
    // ============================================================================

    match /trackingPoints/{pointId} {
      // Historical GPS data is private to its owner and administrators.
      allow read: if isAdminOrOps() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);

      // The app has no supported writer for this legacy history collection.
      allow create, update: if false;

      allow delete: if !hasOwnActiveDeletionRequest() &&
                        (isAdmin() ||
                         (isAuthenticated() &&
                          resource.data.userId == request.auth.uid &&
                          !hasActiveDeletionRequest(request.auth.uid)));
    }

    // ============================================================================
    // LEGACY GLOBAL DRIVER TRACKING
    // ============================================================================

    // The global route is retained only to deny all client access explicitly.
    // v1 GPS is exclusively stored under matches/{matchId}/tracking/current.
    match /tracking/{driverId} {
      allow read, write: if false;
    }

    // v1 does not create GPS history. Legacy history remains non-writable.
    match /locations/{locationId} {
      allow read, write: if false;
    }

    // ============================================================================
    // REQUESTS COLLECTION
    // ============================================================================

    match /requests/{requestId} {
      // Users can read requests where they are parent or driver
      allow read: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        isAdminOrOps()
      );

      // Parents can create their own requests from ParentRequestScreen with strict schema validation
      allow create: if isParent() &&
                      request.resource.data.parentId == request.auth.uid &&
                      !hasActiveDeletionRequest(request.auth.uid) &&
                      request.resource.data.status == 'active' &&
                      request.resource.data.keys().hasAll([
                        'parentId',
                        'school',
                        'zone',
                        'schedule',
                        'childrenCount',
                        'createdAt',
                        'status'
                      ]) &&
                      request.resource.data.keys().hasOnly([
                        'parentId',
                        'parentName',
                        'parentPhone',
                        'school',
                        'zone',
                        'schedule',
                        'childrenCount',
                        'ages',
                        'specialNeeds',
                        'createdAt',
                        'status'
                      ]) &&
                      request.resource.data.school is string &&
                      request.resource.data.school.size() > 0 &&
                      request.resource.data.school.size() <= 200 &&
                      request.resource.data.zone is string &&
                      request.resource.data.zone.size() > 0 &&
                      request.resource.data.zone.size() <= 100 &&
                      request.resource.data.schedule is string &&
                      request.resource.data.schedule.size() > 0 &&
                      request.resource.data.schedule.size() <= 100 &&
                      request.resource.data.childrenCount is int &&
                      request.resource.data.childrenCount >= 1 &&
                      request.resource.data.childrenCount <= 10 &&
                      request.resource.data.createdAt is timestamp &&
                      request.resource.data.createdAt <= request.time &&
                      validRequestSize();

      // Request matching and status are managed by authenticated backend operations.
      allow update: if false;

      // Request removal requires a backend operation that can validate related matches.
      allow delete: if false;
    }

    // ============================================================================
    // VACANCIES COLLECTION
    // ============================================================================

    match /vacancies/{vacancyId} {
      // Only vacancy owner (approved driver) or admin/ops can read vacancies
      allow read: if isAdminOrOps() ||
                    (isApprovedDriver() && resource.data.driverId == request.auth.uid);

      // Only APPROVED drivers can create vacancies
      // Rate limit: max 5 vacancies per day
      allow create: if isApprovedDriver() &&
                      request.resource.data.driverId == request.auth.uid &&
                      !hasActiveDeletionRequest(request.auth.uid) &&
                      validNewVacancyCapacity() &&
                      validRequestSize();

      // Only the driver who created can update
      // Capacity and status transitions are managed by trusted backend operations.
      allow update: if isApprovedDriver() &&
                      resource.data.driverId == request.auth.uid &&
                      !hasActiveDeletionRequest(request.auth.uid) &&
                      resource.data.status != 'cancelled' &&
                      (!('cancellationReason' in resource.data) || resource.data.cancellationReason != 'driver_revoked') &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'driverId',
                        'totalSeats',
                        'availableSeats',
                        'reservedSeats',
                        'cancellationReason',
                        'status'
                      ]) &&
                      rateLimit(600) &&
                      validRequestSize();

      // Only owner or admin can delete
      allow delete: if !hasOwnActiveDeletionRequest() &&
                      resource.data.reservedSeats is int &&
                      resource.data.reservedSeats == 0 &&
                      (isAdmin() ||
                       (isApprovedDriver() &&
                        resource.data.driverId == request.auth.uid &&
                        !hasActiveDeletionRequest(request.auth.uid)));
    }

    // ============================================================================
    // MATCHES COLLECTION
    // ============================================================================

    match /matches/{matchId} {
      // Only the assigned parent/driver or an admin can read a match.
      allow read: if canReadMatch(resource.data);

      // Matches are created and transitioned only by trusted backend code.
      allow create, update, delete: if false;

      match /tracking/{locationId} {
        function canReadMatchLocation() {
          return exists(
            /databases/$(database)/documents/matches/$(matchId)
          ) &&
          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.status == 'active' &&
          canReadMatch(
            get(
              /databases/$(database)/documents/matches/$(matchId)
            ).data
          );
        }

        allow read: if locationId == 'current' &&
                      canReadMatchLocation() &&
                      resource.data.updatedAt is timestamp &&
                      resource.data.updatedAt >
                        request.time - duration.value(2, 'm');

        allow create, update: if locationId == 'current' &&
                                isApprovedDriver() &&
                                activeMatch(matchId) &&
                                get(
                                  /databases/$(database)/documents/matches/$(matchId)
                                ).data.driverId == request.auth.uid &&
                                !hasActiveDeletionRequest(request.auth.uid) &&
                                validTrackingLocation();

        // Shared current points are deleted only by trusted backend code.
        allow delete: if false;
      }
    }

    // ============================================================================
    // HANDOVER OTPS, PASSENGER STATES & CUSTODY EVENTS (Root collections)
    // ============================================================================

    match /handoverOtps/{otpId} {
      allow read, write: if false;
    }

    match /passengerStates/{stateId} {
      allow read: if isMatchParticipant(resource.data.matchId);
      allow write: if false;
    }

    match /custodyEvents/{eventId} {
      allow read: if isMatchParticipant(resource.data.matchId) || isAdminOrOps();
      allow write: if false;
    }

    match /emergencyIncidents/{incidentId} {
      allow read: if isMatchParticipant(resource.data.matchId) || isAdminOrOps();
      allow write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /securityAuditLogs/{logId} {
      allow read, write: if false;
    }

    match /trackingShares/{shareToken} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.parentId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdminOrOps()
      );
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /driverFleets/{driverId} {
      function canReadDriverFleet() {
        return isAuthenticated() && (
          request.auth.uid == driverId ||
          isAdminOrOps()
        );
      }

      match /vehicles/{vehicleId} {
        allow read: if canReadDriverFleet();
        allow write: if false;
      }

      match /assistants/{assistantId} {
        allow read: if canReadDriverFleet();
        allow write: if false;
      }
    }

    // ============================================================================
    // PASSENGERS COLLECTION (F0.10 Child Protection & Data Minimization)
    // ============================================================================

    match /passengers/{passengerId} {
      function canReadPassenger(passengerData) {
        return isAuthenticated() &&
               (isAdminOrOps() ||
                (isParent() && passengerData.parentId == request.auth.uid));
      }

      allow read: if canReadPassenger(resource.data);
      // Passenger onboarding and updates are managed securely by backend Cloud Functions (Admin SDK)
      allow create, update, delete: if false;
    }

    // ============================================================================
    // PASSENGER AUTHORIZATIONS COLLECTION (F0.10 Adult Responsibility Declaration)
    // ============================================================================

    match /passengerAuthorizations/{authorizationId} {
      allow read: if isAuthenticated() &&
                    (isAdminOrOps() || resource.data.guardianId == request.auth.uid);
      // Authorizations are managed exclusively by trusted backend code.
      allow write: if false;
    }

    // Authorization evidence is append-only for trusted backend operations.
    // Admin SDK bypasses Rules; privileged writers remain an IAM/code boundary.
    match /authorizationEvents/{eventId} {
      allow read, write: if false;
    }

    // ============================================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================================

    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;

      // Only backend/cloud functions can write notifications
      allow write: if false;
    }

    // ============================================================================
    // CHAT/MESSAGES COLLECTION (if implemented)
    // ============================================================================

    match /chats/{chatId} {
      // Users can read chats they are part of
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.participants;

      // Users can create chats
      allow create: if isAuthenticated() &&
                      request.auth.uid in request.resource.data.participants &&
                      !hasActiveDeletionRequest(request.auth.uid);

      // Only participants can update, but cannot alter participants or matchId
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants &&
                      !hasActiveDeletionRequest(request.auth.uid) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'matchId']);

      // Only admin can delete chats
      allow delete: if isAdmin() && !hasOwnActiveDeletionRequest();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
                        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                        request.resource.data.senderId == request.auth.uid &&
                        !hasActiveDeletionRequest(request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}
